vestment.html", "doc_type": "ownership", "tickers": ["1180"], "sectors": ["البنوك"], "published_at": 1679875200, "fetched_at": 1784294418, "title_hash": "b6cc996c0b8f47bfc6780293b9b394d8cc83df12", "title_en": "Saudi National Bank's investment in Credit Suisse and its loss"}]}